# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# working notes / investigation files kept out of version control on purpose
deepresarch.txt
*.pwscene

# firebase functions
/functions/node_modules
/functions/lib

# print-pipeline: generated STL/SL1/Photon output and self-built tool binaries -- large binaries
# that don't belong in git, and (worse) can crash the Next.js dev server's file watcher if a
# native tool (PrusaSlicer/UVtools) still has one open/locked when Turbopack tries to read it.
/print-pipeline/output/
/print-pipeline/tools/

.vercel
.env*

# label printer output, local media, scratch posts
label-pipeline/output/
__pycache__/
/music/
/ig-post-*.png

# AI company: reports, drafts and icon URLs stay local
/company/

# Personal photos/notes and the AI-company agent files stay out of the (public) repo
/写真/
/.claude/agents/
/*.txt
