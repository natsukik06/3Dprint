rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'natsukik0616@gmail.com';
    }

    match /orders/{orderId} {
      // Only ever created by the Stripe webhook (Admin SDK, bypasses rules), once payment is
      // confirmed -- see order_drafts below for the pre-payment side of this.
      allow create: if false;
      // Admin sees everything; a signed-in customer sees only their own orders, matched by
      // their VERIFIED auth email (request.auth.token.email, not client-supplied data) against
      // customerEmail -- not by uid, since uid is only captured when the customer happened to be
      // logged in at checkout time (see src/lib/orders.ts), while customerEmail is always
      // present. Powers the customer-facing order-history page (/mypage).
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.customerEmail == request.auth.token.email);
      // Lets the admin toggle operational flags (insertPrinted, shipped) directly from the
      // client -- same trust level as print_batches below. Still can't be created/deleted from
      // the client.
      allow update: if isAdmin();
      allow delete: if false;
    }
    match /counters/{counterId} {
      // Admin-SDK only (Stripe webhook's sequential order-number generator, see
      // src/lib/orderNumber.ts) -- never touched by any client, admin included.
      allow read, write: if false;
    }
    match /order_drafts/{draftId} {
      // Written by the order form before Stripe checkout; promoted into orders/{sameId} by the
      // webhook once payment succeeds (src/app/api/stripe/webhook/route.ts), or left behind
      // (never read back) if the customer abandons checkout -- keeps failed/incomplete attempts
      // out of the admin's real order list entirely, rather than showing up there as permanent
      // "unpaid" clutter.
      allow create: if true;
      allow read, update, delete: if false;
    }
    match /order_items/{itemId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /marketing_subscribers/{subscriberId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /print_batches/{batchId} {
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow create, delete: if false;
    }
    match /jobs/{jobId} {
      // Admin UI polls these for progress; only the Admin SDK (API route + Cloud Function)
      // creates/updates them.
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /product_likes/{productId} {
      // Public "気になる！" tap on the lineup -- no login, so this is a low-stakes interest
      // signal, not authenticated data. Rules only allow the count to move by exactly +-1 per
      // write and never below zero, so a client can write directly without an API route while
      // still being unable to set an arbitrary count.
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count']) &&
        request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count']) &&
        ((request.resource.data.count == resource.data.count + 1) ||
         (request.resource.data.count == resource.data.count - 1 && resource.data.count > 0));
      allow delete: if false;
    }
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // referralDiscountAvailable (and anything else server-managed) must never be
      // client-writable -- only these specific customer-profile fields, and only the doc's own
      // owner. Backs the account-linked 注文者情報 flow (src/lib/customerProfile.ts): a signed-in
      // customer can save their name/address/phone once (at checkout, or from /mypage) instead
      // of retyping it every order.
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['customerName', 'postalCode', 'address', 'phoneNumber']);
      // lastSeenNotificationsAt is the one server-managed-adjacent field a client CAN write
      // itself: it just marks "I've looked at /mypage as of now" (see AuthNavButton's unread-dot
      // logic, driven off it vs. couponUpdatedAt / the latest users/{uid}/models doc) -- writing
      // an arbitrary/future timestamp there only lets a customer dismiss their own notification
      // dot early, not gain or spoof anything of value.
      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['customerName', 'postalCode', 'address', 'phoneNumber', 'lastSeenNotificationsAt']);
      allow delete: if false;

      match /models/{taskId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        // createdAt must be the server's own clock and only the app's own fields may be written:
        // a nightly job deletes old gallery models, so a customer-chosen date or extra field must
        // never be accepted.
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['modelUrl', 'renderedImageUrl', 'finishedPreviewUrls', 'referenceImageUrls', 'subject', 'pose', 'createdAt'])
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
