rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Files the SERVER writes (reference photos, generated models, preview images). The server
    // uses the Admin SDK (see src/lib/storageServer.ts), which bypasses these rules, so nothing
    // needs to be writable from the outside -- previously these folders accepted uploads from any
    // anonymous visitor on the internet. Reads stay public: the app shows these images/models by URL.
    match /orders/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    match /models/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    match /previews/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    // A customer's own bring-your-own 3D model (see uploadCustomModel in src/lib/orders.ts),
    // uploaded from their browser. Only the signed-in owner of the folder may write, and only a GLB
    // under 50MB.
    match /custom-models/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid &&
        request.resource.size < 50 * 1024 * 1024 &&
        request.resource.contentType == 'model/gltf-binary';
    }
    // Print-batch STL files -- admin only. (Admin SDK uploads bypass these rules; this covers
    // uploads from the admin's own signed-in browser.) Previously "any signed-in user" could write.
    match /batches/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.email == 'natsukik0616@gmail.com' &&
        request.resource.size < 50 * 1024 * 1024;
    }
    // Admin-uploaded color swatch photos (see /admin/colors).
    match /colors/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.email == 'natsukik0616@gmail.com' &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
